# MD013 (line length) is disabled because the README has badge and
# reference URLs that cannot be wrapped.
# MD029 (ordered list item prefix) is disabled because CommonMark
# renders incremental numbering from any prefix.
# MD024 (duplicate headers) is disabled because changelog sections
# legitimately repeat (### Bug Fixes etc.) across versions.
rules "~MD013", "~MD024", "~MD029"

FROM --platform=${TARGETPLATFORM:-linux/amd64} alpine:3.22

# Minimal toolchain used ONLY to statically link object files produced by
# `crystal build --cross-compile` on the host. No Crystal compiler needed.
RUN apk add --no-cache \
    gcc \
    musl-dev \
    binutils \
    gc-static \
    pcre2-static \
    yaml-static \
    libxml2-static \
    zlib-static \
    xz-static
